from __future__ import annotations

import hashlib
import json
from pathlib import Path
import runpy
import subprocess
import sys


MIN_PYTHON = (3, 8)
BASE_DASHBOARD_SOURCE = "metrics/grafana/ticdc_new_arch.dashboard.py"
BASE_DASHBOARD_JSON = "metrics/grafana/ticdc_new_arch.json"
DEFAULT_DASHBOARD_FILES = [
    BASE_DASHBOARD_JSON,
    "metrics/nextgengrafana/ticdc_new_arch_next_gen.json",
    "metrics/nextgengrafana/ticdc_new_arch_with_keyspace_name.json",
]


def discover_repo_root():
    return Path(__file__).absolute().parents[1]


def require_python_version():
    if sys.version_info < MIN_PYTHON:
        raise SystemExit(
            "python3 >= {}.{} is required".format(MIN_PYTHON[0], MIN_PYTHON[1])
        )


def load_dashboard_builder(repo_root):
    dashboard_source = repo_root / BASE_DASHBOARD_SOURCE
    old_sys_path = list(sys.path)
    try:
        sys.path.insert(0, str(repo_root / "metrics/grafana"))
        sys.path.insert(0, str(repo_root))
        globals_dict = runpy.run_path(str(dashboard_source))
    finally:
        sys.path[:] = old_sys_path

    build_dashboard = globals_dict.get("build_dashboard")
    if build_dashboard is None:
        raise SystemExit("missing build_dashboard() in {}".format(dashboard_source))
    return build_dashboard


def write_json(path, payload):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("w", encoding="utf-8") as f:
        json.dump(payload, f, indent=2, ensure_ascii=False, sort_keys=False)
        f.write("\n")


def make_checksum_line(repo_root, path):
    digest = hashlib.sha256(path.read_bytes()).hexdigest()
    relative = path.resolve().relative_to(repo_root.resolve()).as_posix()
    return "{}  {}".format(digest, relative)


def write_checksum_file(repo_root, dashboard_path):
    checksum_path = dashboard_path.parent / "{}.sha256".format(dashboard_path.name)
    checksum_path.write_text(
        make_checksum_line(repo_root, dashboard_path) + "\n",
        encoding="utf-8",
    )
    return checksum_path


def run_next_gen_generator(repo_root):
    subprocess.run(
        ["bash", str(repo_root / "scripts/generate-next-gen-metrics.sh")],
        cwd=repo_root,
        check=True,
    )


def main():
    require_python_version()
    repo_root = discover_repo_root()
    build_dashboard = load_dashboard_builder(repo_root)
    dashboard = build_dashboard()
    if not isinstance(dashboard, dict):
        raise SystemExit("build_dashboard() must return a dict")

    base_dashboard_path = repo_root / BASE_DASHBOARD_JSON
    write_json(base_dashboard_path, dashboard)
    run_next_gen_generator(repo_root)

    for relative_path in DEFAULT_DASHBOARD_FILES:
        write_checksum_file(repo_root, repo_root / relative_path)

    return 0


if __name__ == "__main__":
    sys.exit(main())
